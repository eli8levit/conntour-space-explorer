# syntax=docker/dockerfile:1

FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 3001

# --host 0.0.0.0 so the server is reachable from outside the container.
# The proxy target comes from REACT_APP_API_URL in docker-compose.dev.yml.
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "3001"]
